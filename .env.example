# Observability (optional — features no-op when unset)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Required (no hardcoded fallbacks since security batch 1). Lovable Cloud injects
# these automatically; on Vercel/local set them yourself (anon/publishable key only).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-or-publishable-key>
VITE_SUPABASE_PROJECT_ID=<project-ref>
