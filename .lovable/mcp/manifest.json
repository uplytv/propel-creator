      {
        "name": "create_business_profile",
        "title": "Create business profile",
        "description": "Admin only. Create (or promote) a business tenant. If the username matches an existing profile, promote it; otherwise create a new profile row owned by the calling admin (draft until claimed), then upsert business_details. Returns username and public URL.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "username": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "user_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "business_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "category": {
              "type": "string",
              "maxLength": 100
            },
            "tagline": {
              "type": "string",
              "maxLength": 500
            },
            "address": {
              "type": "string",
              "maxLength": 500
            },
            "city": {
              "type": "string",
              "maxLength": 100
            },
            "phone": {
              "type": "string",
              "maxLength": 30
            },
            "email": {
              "type": "string",
              "maxLength": 255,
              "format": "email",
              "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            "google_maps_url": {
              "type": "string",
              "format": "uri"
            },
            "google_rating": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "google_reviews_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "status": {
              "default": "draft",
              "type": "string",
              "enum": [
                "draft",
                "claimed",
                "live"
              ]
            }
          },
          "required": [
            "business_name"
          ]
        },
        "outputSchema": null
      },
