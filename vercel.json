{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/arya", "destination": "https://dbjlhmbgskvhuzqvqfrl.supabase.co/functions/v1/og-image?path=/arya" },
    { "source": "/aryaxo", "destination": "https://dbjlhmbgskvhuzqvqfrl.supabase.co/functions/v1/og-image?path=/aryaxo" },
    { "source": "/arya-xo", "destination": "https://dbjlhmbgskvhuzqvqfrl.supabase.co/functions/v1/og-image?path=/arya-xo" },
    { "source": "/arya-xo-site", "destination": "https://dbjlhmbgskvhuzqvqfrl.supabase.co/functions/v1/og-image?path=/arya-xo-site" },
    { "source": "/arya-xo-links", "destination": "https://dbjlhmbgskvhuzqvqfrl.supabase.co/functions/v1/og-image?path=/arya-xo-links" },
    { "source": "/arya/links", "destination": "https://dbjlhmbgskvhuzqvqfrl.supabase.co/functions/v1/og-image?path=/arya/links" },
    { "source": "/aryaxo/links", "destination": "https://dbjlhmbgskvhuzqvqfrl.supabase.co/functions/v1/og-image?path=/aryaxo/links" },
    { "source": "/arya-xo/links", "destination": "https://dbjlhmbgskvhuzqvqfrl.supabase.co/functions/v1/og-image?path=/arya-xo/links" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
